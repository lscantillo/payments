# Copy to .env on the server. Never commit .env.
# Use a URL-safe password. The private key stays in this file and is not baked into the image.

POSTGRES_PASSWORD=replace-with-a-long-password
PUBLIC_HOST=:80
PUBLIC_ORIGIN=http://YOUR_SERVER_IP

GATEWAY_API_URL=https://api-sandbox.co.uat.wompi.dev/v1
GATEWAY_PUBLIC_KEY=
GATEWAY_PRIVATE_KEY=
GATEWAY_INTEGRITY_SECRET=
GATEWAY_MODE=sandbox
